{
  "version": 2,
  "builds": [
    {
      "src": "kinggpt.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/kinggpt.js"
    },
    {
      "src": "/(.*\\.(css|js|png|jpg|jpeg|svg|ico|webp))",
      "dest": "/$1"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
