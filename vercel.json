{
  "version": 2,
  "builds": [
    {
      "src": "kinggpt.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/kinggpt.js"
    },
    {
      "src": "/style.css",
      "dest": "/style.css"
    },
    {
      "src": "/app.js",
      "dest": "/app.js"
    },
    {
      "src": "/1787430604018.png",
      "dest": "/1787430604018.png"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
